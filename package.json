{
  "name": "typeripper",
  "version": "0.1.0",
  "description": "Flow-sensitive static type inference engine for JavaScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "infer": "tsx scripts/infer.ts",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "type-inference",
    "static-analysis",
    "javascript",
    "flow-sensitive",
    "mlsub"
  ],
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.26.0",
    "@babel/traverse": "^7.26.0",
    "@babel/types": "^7.26.0"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "tsx": "^4.19.2"
  }
}
